@model SpendWise.Admin.Models.AdminLoginViewModel

@{
    Layout = null;

    ViewData["Title"] = "SpendWise Admin Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>SpendWise Admin | Login</title>

    <link rel="stylesheet"
          href="~/css/admin-login.css"
          asp-append-version="true" />
</head>

<body>

    <main class="login-container">

        <section class="login-card">

            <div class="brand">
                <div class="brand-icon">S</div>

                <h1>SpendWise</h1>

                <p>ADMINISTRATION PORTAL</p>
            </div>

            <div class="welcome">
                <h2>Welcome back</h2>

                <p>
                    Sign in to access your administration dashboard.
                </p>
            </div>

            <form asp-controller="AdminAccount"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="form-group">

                    <label asp-for="Email">
                        Administrator email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           placeholder="admin@spendwise.co.za"
                           autocomplete="username" />

                    <span asp-validation-for="Email"
                          class="field-error"></span>

                </div>

                <div class="form-group">

                    <label asp-for="Password">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           placeholder="Enter your password"
                           autocomplete="current-password" />

                    <span asp-validation-for="Password"
                          class="field-error"></span>

                </div>

                <div class="login-options">

                    <label class="remember">
                        <input asp-for="RememberMe" />
                        Remember me
                    </label>

                    <span class="forgot-text">
                        Forgot password?
                    </span>

                </div>

                <button type="submit" class="login-button">
                    Sign In Securely
                </button>

            </form>

            <div class="security-note">
                <span>🔒</span>
                Protected administrator access
            </div>

            <footer>
                © 2026 SpendWise. All rights reserved.
            </footer>

        </section>

    </main>

</body>
</html>

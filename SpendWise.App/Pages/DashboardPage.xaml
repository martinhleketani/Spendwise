<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SpendWise.App.Pages.DashboardPage"
    BackgroundColor="#F5F7F6"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Grid Grid.Row="0"
              Padding="20,20"
              BackgroundColor="#146B3A"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">

            <VerticalStackLayout Spacing="3"
                                 VerticalOptions="Center">

                <Label Text="Martin SpendWise"
                       TextColor="White"
                       FontSize="23"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation" />

                <Label x:Name="WelcomeLabel"
                       Text="Welcome back"
                       TextColor="#D8F3E3"
                       FontSize="14"
                       LineBreakMode="TailTruncation" />

            </VerticalStackLayout>

            <!-- NOTIFICATION BELL AND PROFILE -->
            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="5"
                VerticalOptions="Center">

                <Button
                    x:Name="NotificationsButton"
                    Text="🔔"
                    FontSize="20"
                    BackgroundColor="#2A7E4D"
                    TextColor="White"
                    CornerRadius="12"
                    WidthRequest="48"
                    HeightRequest="48"
                    Clicked="NotificationsButton_Clicked"
                    SemanticProperties.Description="Open budget notifications" />

                <Label
                    x:Name="UnreadNotificationsLabel"
                    Text=""
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#FFE082"
                    VerticalOptions="Center"
                    IsVisible="False" />

                <Button
                    Text="Profile"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="ProfileButton_Clicked" />

            </HorizontalStackLayout>
        </Grid>

        <!-- MAIN DASHBOARD -->
        <ScrollView Grid.Row="1">
            <Grid Padding="20"
                  ColumnDefinitions="*"
                  HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="18">

                    <!-- BANK ACCOUNT -->
                    <Border BackgroundColor="#146B3A"
                            StrokeThickness="0"
                            Padding="22"
                            StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Bank Account"
                                           TextColor="#D8F3E3"
                                           FontSize="14" />

                                    <Label Text="Account Balance"
                                           TextColor="White"
                                           FontSize="13" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        BackgroundColor="#2A7E4D"
                                        StrokeThickness="0"
                                        Padding="10,5"
                                        StrokeShape="RoundRectangle 10">

                                    <Label x:Name="BankStatusLabel"
                                           Text="Not Connected"
                                           TextColor="White"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <Label x:Name="WalletBalanceLabel"
                                   Text="—"
                                   TextColor="White"
                                   FontSize="34"
                                   FontAttributes="Bold" />

                            <Label x:Name="BankAccountInfoLabel"
                                   Text="Connect your bank securely to view your account balance."
                                   TextColor="#D8F3E3"
                                   FontSize="13"
                                   LineBreakMode="WordWrap" />

                            <Button x:Name="ConnectBankButton"
                                    Text="Connect Bank Account"
                                    BackgroundColor="White"
                                    TextColor="#146B3A"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    Clicked="ConnectBankButton_Clicked" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- BANK INFORMATION -->
                    <Border BackgroundColor="#EAF5EE"
                            Stroke="#C8DFD0"
                            Padding="15"
                            StrokeShape="RoundRectangle 14">

                        <Label
                            Text="Bank integration is not connected yet. SpendWise will not display or store a fake bank balance."
                            FontSize="12"
                            TextColor="#50645A"
                            LineBreakMode="WordWrap" />
                    </Border>

                    <!-- MONTHLY BUDGET -->
                    <Border BackgroundColor="White"
                            Stroke="#E5E5E5"
                            Padding="20"
                            StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Monthly Budget"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#172B20" />

                                <Button Grid.Column="1"
                                        Text="View"
                                        BackgroundColor="Transparent"
                                        TextColor="#146B3A"
                                        Clicked="BudgetButton_Clicked" />
                            </Grid>

                            <Label x:Name="BudgetSpentLabel"
                                   Text="R 0.00 spent of R 0.00"
                                   TextColor="#666666"
                                   FontSize="14" />

                            <ProgressBar x:Name="BudgetProgressBar"
                                         Progress="0"
                                         ProgressColor="#146B3A"
                                         BackgroundColor="#E4EAE6"
                                         HeightRequest="9" />

                            <Grid ColumnDefinitions="*,Auto">

                                <Label x:Name="BudgetRemainingLabel"
                                       Text="R 0.00 remaining"
                                       TextColor="#146B3A"
                                       FontAttributes="Bold" />

                                <Label x:Name="BudgetPercentageLabel"
                                       Grid.Column="1"
                                       Text="0%"
                                       TextColor="#666666" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- QUICK ACTIONS -->
                    <Label Text="Quick Actions"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#172B20" />

                    <Grid ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">

                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Text="Activity"
                                HeightRequest="65"
                                BackgroundColor="White"
                                TextColor="#146B3A"
                                BorderColor="#DCE5DF"
                                BorderWidth="1"
                                CornerRadius="12"
                                Clicked="WalletButton_Clicked" />

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Text="Budget"
                                HeightRequest="65"
                                BackgroundColor="White"
                                TextColor="#146B3A"
                                BorderColor="#DCE5DF"
                                BorderWidth="1"
                                CornerRadius="12"
                                Clicked="BudgetButton_Clicked" />

                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Text="Grocery"
                                HeightRequest="65"
                                BackgroundColor="White"
                                TextColor="#146B3A"
                                BorderColor="#DCE5DF"
                                BorderWidth="1"
                                CornerRadius="12"
                                Clicked="GroceryButton_Clicked" />

                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Text="Purchase"
                                HeightRequest="65"
                                BackgroundColor="White"
                                TextColor="#146B3A"
                                BorderColor="#DCE5DF"
                                BorderWidth="1"
                                CornerRadius="12"
                                Clicked="PurchaseButton_Clicked" />

                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Text="Reports"
                                HeightRequest="65"
                                BackgroundColor="White"
                                TextColor="#146B3A"
                                BorderColor="#DCE5DF"
                                BorderWidth="1"
                                CornerRadius="12"
                                Clicked="ReportsButton_Clicked" />

                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Text="Insights"
                                HeightRequest="65"
                                BackgroundColor="White"
                                TextColor="#146B3A"
                                BorderColor="#DCE5DF"
                                BorderWidth="1"
                                CornerRadius="12"
                                Clicked="InsightsButton_Clicked" />
                    </Grid>

                    <!-- SAVED GROCERY LISTS -->
                    <Button
                        Text="My Grocery Lists"
                        BackgroundColor="#E8F3EC"
                        TextColor="#146B3A"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="12"
                        HeightRequest="52"
                        Clicked="MyGroceryListsButton_Clicked" />

                    <!-- MONTHLY SUMMARY -->
                    <Border BackgroundColor="White"
                            Stroke="#E5E5E5"
                            Padding="20"
                            StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="14">

                            <Label Text="This Month"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#172B20" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">

                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Total Spent"
                                           FontSize="13"
                                           TextColor="#777777" />

                                    <Label x:Name="MonthlySpentLabel"
                                           Text="R 0.00"
                                           FontSize="21"
                                           FontAttributes="Bold"
                                           TextColor="#C0392B" />
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5">

                                    <Label Text="Budget Remaining"
                                           FontSize="13"
                                           TextColor="#777777" />

                                    <Label x:Name="MonthlyRemainingLabel"
                                           Text="R 0.00"
                                           FontSize="21"
                                           FontAttributes="Bold"
                                           TextColor="#146B3A" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- RECENT SPENDING -->
                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Recent Spending"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#172B20" />

                            <Label Text="Recently recorded purchases"
                                   FontSize="12"
                                   TextColor="#777777" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="View All"
                                BackgroundColor="Transparent"
                                TextColor="#146B3A"
                                Clicked="ViewTransactionsButton_Clicked" />
                    </Grid>

                    <Border BackgroundColor="White"
                            Stroke="#E5E5E5"
                            Padding="20"
                            StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout
                            x:Name="RecentTransactionsLayout"
                            Spacing="12">

                            <Label x:Name="NoTransactionsLabel"
                                   Text="No recent spending recorded yet."
                                   TextColor="#777777"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,15" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- SECURITY -->
                    <Border BackgroundColor="White"
                            Stroke="#E5E5E5"
                            Padding="17"
                            StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Secure Banking"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#172B20" />

                            <Label
                                Text="When bank integration is added, connections will be handled through an authorised banking or payment provider. SpendWise will not ask you to enter your banking password or PIN directly into the app."
                                FontSize="12"
                                TextColor="#666666"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- BOTTOM NAVIGATION -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="4,8"
              ColumnDefinitions="*,*,*,*,*">

            <Button Grid.Column="0"
                    Text="Home"
                    FontSize="11"
                    Padding="2"
                    BackgroundColor="Transparent"
                    TextColor="#146B3A"
                    FontAttributes="Bold" />

            <Button Grid.Column="1"
                    Text="Grocery"
                    FontSize="11"
                    Padding="2"
                    BackgroundColor="Transparent"
                    TextColor="#666666"
                    Clicked="GroceryButton_Clicked" />

            <Button Grid.Column="2"
                    Text="Budget"
                    FontSize="11"
                    Padding="2"
                    BackgroundColor="Transparent"
                    TextColor="#666666"
                    Clicked="BudgetButton_Clicked" />

            <Button Grid.Column="3"
                    Text="Profile"
                    FontSize="11"
                    Padding="2"
                    BackgroundColor="Transparent"
                    TextColor="#666666"
                    Clicked="ProfileButton_Clicked" />

            <Button Grid.Column="4"
                    Text="Help"
                    FontSize="11"
                    Padding="2"
                    BackgroundColor="Transparent"
                    TextColor="#146B3A"
                    Clicked="HelpButton_Clicked" />
        </Grid>

    </Grid>
</ContentPage>

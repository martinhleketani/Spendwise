<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SpendWise.App.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>

        <Grid
            Padding="25"
            RowDefinitions="Auto,*">

            <!-- BACK BUTTON -->
            <Button
                Grid.Row="0"
                Text="←"
                FontSize="24"
                TextColor="{StaticResource Primary}"
                BackgroundColor="Transparent"
                WidthRequest="50"
                HeightRequest="50"
                HorizontalOptions="Start"
                Clicked="BackButton_Clicked" />


            <!-- LOGIN CONTENT -->
            <VerticalStackLayout
                Grid.Row="1"
                MaximumWidthRequest="500"
                WidthRequest="450"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="18">


                <!-- LOGO -->
                <Border
                    WidthRequest="80"
                    HeightRequest="80"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource PrimaryLight}"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40" />
                    </Border.StrokeShape>

                    <Label
                        Text="👤"
                        FontSize="38"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>


                <!-- HEADING -->
                <Label
                    Text="Welcome Back"
                    Style="{StaticResource PageTitleStyle}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Sign in to your Martin SpendWise account"
                    Style="{StaticResource BodyTextStyle}"
                    HorizontalTextAlignment="Center"
                    Margin="0,0,0,15" />


                <!-- EMAIL -->
                <Label
                    Text="Email"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Border
                    BackgroundColor="#F1F3F2"
                    Stroke="#8A9690"
                    StrokeThickness="1.5"
                    HeightRequest="56"
                    Padding="12,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Entry
                        x:Name="EmailEntry"
                        Placeholder="Enter your email"
                        PlaceholderColor="#777777"
                        TextColor="#1E1E1E"
                        BackgroundColor="Transparent"
                        Keyboard="Email"
                        FontSize="15"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />

                </Border>


                <!-- PASSWORD -->
                <Label
                    Text="Password"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Border
                    BackgroundColor="#F1F3F2"
                    Stroke="#8A9690"
                    StrokeThickness="1.5"
                    HeightRequest="56"
                    Padding="12,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="5">

                        <Entry
                            x:Name="PasswordEntry"
                            Grid.Column="0"
                            Placeholder="Enter your password"
                            PlaceholderColor="#777777"
                            TextColor="#1E1E1E"
                            BackgroundColor="Transparent"
                            IsPassword="True"
                            FontSize="15"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />

                        <Button
                            x:Name="ShowPasswordButton"
                            Grid.Column="1"
                            Text="Show"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}"
                            BackgroundColor="Transparent"
                            Padding="8,0"
                            VerticalOptions="Center"
                            Clicked="ShowPasswordButton_Clicked" />

                    </Grid>

                </Border>


                <!-- FORGOT PASSWORD -->
                <Button
                    Text="Forgot Password?"
                    TextColor="{StaticResource Primary}"
                    BackgroundColor="Transparent"
                    HorizontalOptions="End"
                    Padding="0"
                    Clicked="ForgotPasswordButton_Clicked" />


                <!-- ERROR -->
                <Label
                    x:Name="ErrorLabel"
                    Text=""
                    TextColor="{StaticResource ExpenseRed}"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    IsVisible="False" />


                <!-- LOGIN -->
                <Button
                    x:Name="LoginButton"
                    Text="Login"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="LoginButton_Clicked" />


                <!-- DIVIDER -->
                <Grid
                    ColumnDefinitions="*,Auto,*"
                    ColumnSpacing="12"
                    Margin="0,10">

                    <BoxView
                        Grid.Column="0"
                        HeightRequest="1"
                        BackgroundColor="{StaticResource BorderColor}"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="or"
                        TextColor="{StaticResource TextSecondary}" />

                    <BoxView
                        Grid.Column="2"
                        HeightRequest="1"
                        BackgroundColor="{StaticResource BorderColor}"
                        VerticalOptions="Center" />

                </Grid>


                <!-- REGISTER -->
                <Button
                    Text="Create Account"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Clicked="CreateAccountButton_Clicked" />


                <Label
                    Text="Martin SpendWise"
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalTextAlignment="Center"
                    Margin="0,10,0,0" />

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ========================= -->
    <!-- PAGE -->
    <!-- ========================= -->

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="{StaticResource PageBackground}" />
    </Style>


    <!-- ========================= -->
    <!-- LABELS -->
    <!-- ========================= -->

    <Style x:Key="PageTitleStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="SectionTitleStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="BodyTextStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor"
                Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="MoneyStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
    </Style>


    <!-- ========================= -->
    <!-- PRIMARY BUTTON -->
    <!-- ========================= -->

    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button">

        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}" />

        <Setter Property="TextColor"
                Value="{StaticResource White}" />

        <Setter Property="FontSize"
                Value="16" />

        <Setter Property="FontAttributes"
                Value="Bold" />

        <Setter Property="HeightRequest"
                Value="52" />

        <Setter Property="CornerRadius"
                Value="12" />

        <Setter Property="Padding"
                Value="16,10" />

    </Style>


    <!-- ========================= -->
    <!-- SECONDARY BUTTON -->
    <!-- ========================= -->

    <Style x:Key="SecondaryButtonStyle"
           TargetType="Button">

        <Setter Property="BackgroundColor"
                Value="{StaticResource White}" />

        <Setter Property="TextColor"
                Value="{StaticResource Primary}" />

        <Setter Property="BorderColor"
                Value="{StaticResource Primary}" />

        <Setter Property="BorderWidth"
                Value="1" />

        <Setter Property="FontSize"
                Value="16" />

        <Setter Property="FontAttributes"
                Value="Bold" />

        <Setter Property="HeightRequest"
                Value="52" />

        <Setter Property="CornerRadius"
                Value="12" />

    </Style>


    <!-- ========================= -->
    <!-- INPUT -->
    <!-- ========================= -->

    <Style x:Key="InputStyle"
           TargetType="Entry">

        <Setter Property="BackgroundColor"
                Value="{StaticResource White}" />

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="PlaceholderColor"
                Value="{StaticResource TextSecondary}" />

        <Setter Property="FontSize"
                Value="15" />

        <Setter Property="HeightRequest"
                Value="50" />

        <Setter Property="Margin"
                Value="0,4" />

    </Style>


    <!-- ========================= -->
    <!-- CARD -->
    <!-- ========================= -->

    <Style x:Key="CardStyle"
           TargetType="Border">

        <Setter Property="BackgroundColor"
                Value="{StaticResource CardBackground}" />

        <Setter Property="Stroke"
                Value="{StaticResource BorderColor}" />

        <Setter Property="StrokeThickness"
                Value="1" />

        <Setter Property="Padding"
                Value="16" />

        <Setter Property="Margin"
                Value="0,6" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>

    </Style>


    <!-- ========================= -->
    <!-- INCOME TEXT -->
    <!-- ========================= -->

    <Style x:Key="IncomeTextStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource IncomeGreen}" />

        <Setter Property="FontAttributes"
                Value="Bold" />

    </Style>


    <!-- ========================= -->
    <!-- EXPENSE TEXT -->
    <!-- ========================= -->

    <Style x:Key="ExpenseTextStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource ExpenseRed}" />

        <Setter Property="FontAttributes"
                Value="Bold" />

    </Style>

</ResourceDictionary>
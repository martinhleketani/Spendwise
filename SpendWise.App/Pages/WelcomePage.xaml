<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SpendWise.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#003D2F">

    <ScrollView x:Name="MainScroll">
        <VerticalStackLayout Spacing="0">

            <!-- Header -->
            <Grid
                Padding="35,20"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="25">

                <!-- Logo -->
                <HorizontalStackLayout
                    Grid.Column="0"
                    Spacing="10"
                    VerticalOptions="Center">

                    <Border
                        WidthRequest="42"
                        HeightRequest="42"
                        BackgroundColor="#00B982"
                        Stroke="#42E6B0"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="11"/>
                        </Border.StrokeShape>

                        <Label
                            Text="S"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                    </Border>

                    <Label
                        Text="SpendWise"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="White"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Navigation -->
                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="28"
                    HorizontalOptions="End"
                    VerticalOptions="Center">

                    <Button
                        Text="Features"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="14"
                        Clicked="FeaturesButton_Clicked"/>

                    <Button
                        Text="Support"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="14"
                        Clicked="SupportButton_Clicked"/>
                </HorizontalStackLayout>

                <!-- Account buttons -->
                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="10"
                    VerticalOptions="Center">

                    <Button
                        Text="Login"
                        WidthRequest="105"
                        HeightRequest="43"
                        BackgroundColor="Transparent"
                        BorderColor="#55A88E"
                        BorderWidth="1"
                        CornerRadius="12"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="LoginButton_Clicked"/>

                    <Button
                        Text="Get Started  →"
                        HeightRequest="43"
                        Padding="18,0"
                        BackgroundColor="#00B982"
                        TextColor="White"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        Clicked="CreateAccountButton_Clicked"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- Hero section -->
            <Grid
                Padding="55,35,55,30"
                ColumnDefinitions="1.05*,1.1*"
                ColumnSpacing="35"
                MinimumHeightRequest="390">

                <!-- Left side -->
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="20"
                    VerticalOptions="Center">

                    <Border
                        BackgroundColor="#104E40"
                        Stroke="#00B982"
                        StrokeThickness="1"
                        HorizontalOptions="Start"
                        Padding="15,8">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>

                        <Label
                            Text="✦  Budget Smarter, Shop Better"
                            TextColor="#55E6B4"
                            FontAttributes="Bold"
                            FontSize="14"/>
                    </Border>

                    <Label
                        Text="Your Money &amp; Groceries.&#10;Unified."
                        FontSize="42"
                        FontAttributes="Bold"
                        TextColor="White"
                        LineHeight="1.1"/>

                    <Label
                        Text="Master your household spending and grocery lists in one powerful app. Plan smarter, track instantly, save more."
                        FontSize="17"
                        TextColor="#C6DED5"
                        LineHeight="1.4"/>

                </VerticalStackLayout>

                <!-- Dashboard preview -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="#145C49"
                    Stroke="#267F65"
                    StrokeThickness="2"
                    Padding="12"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Border
                        BackgroundColor="#F7FAF9"
                        Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>

                        <Grid
                            RowDefinitions="Auto,*"
                            RowSpacing="12">

                            <!-- Dashboard top bar -->
                            <Grid
                                Grid.Row="0"
                                ColumnDefinitions="Auto,*,Auto"
                                Padding="4,2">

                                <HorizontalStackLayout
                                    Spacing="7">

                                    <Border
                                        BackgroundColor="#009F70"
                                        WidthRequest="25"
                                        HeightRequest="25">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>

                                        <Label
                                            Text="S"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"/>
                                    </Border>

                                    <Label
                                        Text="SpendWise"
                                        TextColor="#123C32"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"
                                        FontSize="13"/>
                                </HorizontalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="Dashboard"
                                    TextColor="#123C32"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    Margin="15,0"/>

                                <Label
                                    Grid.Column="2"
                                    Text="●  ●  ●"
                                    TextColor="#009F70"
                                    VerticalOptions="Center"/>
                            </Grid>

                            <!-- Dashboard body -->
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="0.8*,1.2*"
                                ColumnSpacing="10">

                                <!-- Sidebar -->
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    BackgroundColor="#F0F6F3"
                                    Padding="8"
                                    Spacing="14">

                                    <Label
                                        Text="▣  Dashboard"
                                        TextColor="#009F70"
                                        FontAttributes="Bold"
                                        FontSize="11"/>

                                    <Label
                                        Text="▤  Plan"
                                        TextColor="#657B74"
                                        FontSize="11"/>

                                    <Label
                                        Text="◉  Budget"
                                        TextColor="#657B74"
                                        FontSize="11"/>

                                    <Label
                                        Text="▧  Lists"
                                        TextColor="#657B74"
                                        FontSize="11"/>

                                    <Label
                                        Text="▥  Activity"
                                        TextColor="#657B74"
                                        FontSize="11"/>
                                </VerticalStackLayout>

                                <!-- Dashboard content -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="9">

                                    <!-- Budget progress -->
                                    <Border
                                        BackgroundColor="White"
                                        Stroke="#E4ECE8"
                                        Padding="10">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>

                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="8">

                                            <VerticalStackLayout
                                                Spacing="8"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="Monthly Budget Progress"
                                                    TextColor="#183D33"
                                                    FontSize="10"
                                                    FontAttributes="Bold"/>

                                                <Label
                                                    Text="78%"
                                                    TextColor="#009F70"
                                                    FontSize="29"
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="Center"/>

                                                <ProgressBar
                                                    Progress="0.78"
                                                    ProgressColor="#00B982"
                                                    BackgroundColor="#E4EEE9"/>
                                            </VerticalStackLayout>

                                            <Image
                                                Grid.Column="1"
                                                Source="grocery_trolley.png"
                                                Aspect="AspectFit"
                                                HeightRequest="110"/>
                                        </Grid>
                                    </Border>

                                    <!-- Transactions and grocery list -->
                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="8">

                                        <Border
                                            BackgroundColor="White"
                                            Stroke="#E4ECE8"
                                            Padding="9">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="9">

                                                <Label
                                                    Text="Recent Transactions"
                                                    TextColor="#183D33"
                                                    FontAttributes="Bold"
                                                    FontSize="10"/>

                                                <Label
                                                    Text="🛒  Woolworths     -R450"
                                                    TextColor="#344D45"
                                                    FontSize="9"/>

                                                <Label
                                                    Text="⚡  Electricity    -R1200"
                                                    TextColor="#344D45"
                                                    FontSize="9"/>
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border
                                            Grid.Column="1"
                                            BackgroundColor="White"
                                            Stroke="#E4ECE8"
                                            Padding="9">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="9">

                                                <Label
                                                    Text="Grocery List"
                                                    TextColor="#183D33"
                                                    FontAttributes="Bold"
                                                    FontSize="10"/>

                                                <Label
                                                    Text="✓  Milk"
                                                    TextColor="#344D45"
                                                    FontSize="10"/>

                                                <Label
                                                    Text="✓  Bread"
                                                    TextColor="#344D45"
                                                    FontSize="10"/>

                                                <Label
                                                    Text="✓  Bananas"
                                                    TextColor="#344D45"
                                                    FontSize="10"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <!-- Features section -->
            <Grid
                x:Name="FeaturesSection"
                Padding="55,15,55,45"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="18">

                <!-- Plan groceries -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E4ECE8"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17"/>
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="15">

                        <Label
                            Text="📝"
                            FontSize="34"
                            VerticalOptions="Center"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="7"
                            VerticalOptions="Center">

                            <Label
                                Text="Plan Groceries"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#102F27"/>

                            <Label
                                Text="Build smart lists &amp; set category limits."
                                FontSize="13"
                                TextColor="#455B53"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Track expenses -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E4ECE8"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17"/>
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="15">

                        <Label
                            Text="👛"
                            FontSize="34"
                            VerticalOptions="Center"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="7"
                            VerticalOptions="Center">

                            <Label
                                Text="Track Expenses"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#102F27"/>

                            <Label
                                Text="Log every rand and monitor spending trends."
                                FontSize="13"
                                TextColor="#455B53"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Save money -->
                <Border
                    Grid.Column="2"
                    BackgroundColor="White"
                    Stroke="#E4ECE8"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17"/>
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="15">

                        <Label
                            Text="🌱"
                            FontSize="34"
                            VerticalOptions="Center"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="7"
                            VerticalOptions="Center">

                            <Label
                                Text="Save Money"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#102F27"/>

                            <Label
                                Text="Identify savings opportunities and achieve financial goals."
                                FontSize="13"
                                TextColor="#455B53"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid
                Padding="35,22"
                ColumnDefinitions="*,Auto"
                BackgroundColor="#003629">

                <Label
                    Text="© 2026 SpendWise Inc. All rights reserved."
                    TextColor="#B9D1C8"
                    FontSize="12"
                    VerticalOptions="Center"/>

                <Label
                    Grid.Column="1"
                    Text="Privacy"
                    TextColor="#B9D1C8"
                    FontSize="12"
                    VerticalOptions="Center"
                    Margin="15,0"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

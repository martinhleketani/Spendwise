<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SpendWise.App.Pages.GroceryPage"
    Title="Grocery Calculator"
    BackgroundColor="#F5F7F6">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Style x:Key="CardStyle"
                   TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="White" />
                <Setter Property="Stroke"
                        Value="#E4EAE6" />
                <Setter Property="StrokeThickness"
                        Value="1" />
                <Setter Property="Padding"
                        Value="18" />
                <Setter Property="StrokeShape"
                        Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="HeadingStyle"
                   TargetType="Label">
                <Setter Property="FontSize"
                        Value="18" />
                <Setter Property="FontAttributes"
                        Value="Bold" />
                <Setter Property="TextColor"
                        Value="#172B20" />
            </Style>

            <Style x:Key="FieldLabelStyle"
                   TargetType="Label">
                <Setter Property="FontSize"
                        Value="13" />
                <Setter Property="FontAttributes"
                        Value="Bold" />
                <Setter Property="TextColor"
                        Value="#526459" />
            </Style>

            <Style x:Key="InputStyle"
                   TargetType="Entry">
                <Setter Property="BackgroundColor"
                        Value="#F3F6F4" />
                <Setter Property="TextColor"
                        Value="#172B20" />
                <Setter Property="PlaceholderColor"
                        Value="#829087" />
                <Setter Property="FontSize"
                        Value="15" />
                <Setter Property="HeightRequest"
                        Value="50" />
            </Style>

            <Style x:Key="PrimaryButtonStyle"
                   TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="#146B3A" />
                <Setter Property="TextColor"
                        Value="White" />
                <Setter Property="FontSize"
                        Value="15" />
                <Setter Property="FontAttributes"
                        Value="Bold" />
                <Setter Property="CornerRadius"
                        Value="10" />
                <Setter Property="HeightRequest"
                        Value="50" />
            </Style>

            <Style x:Key="SecondaryButtonStyle"
                   TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="#E8F3EC" />
                <Setter Property="TextColor"
                        Value="#146B3A" />
                <Setter Property="FontSize"
                        Value="14" />
                <Setter Property="FontAttributes"
                        Value="Bold" />
                <Setter Property="CornerRadius"
                        Value="10" />
                <Setter Property="HeightRequest"
                        Value="48" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#146B3A"
            Padding="20,14"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">

            <Button
                Grid.Column="0"
                Text="←"
                FontSize="22"
                TextColor="White"
                BackgroundColor="Transparent"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                Clicked="BackButton_Clicked" />

            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center"
                Spacing="3">

                <Label
                    Text="SpendWise"
                    FontSize="23"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Plan your groceries smarter"
                    FontSize="13"
                    TextColor="#D8F0E1" />

            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Text="↻"
                FontSize="22"
                TextColor="White"
                BackgroundColor="Transparent"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                Clicked="RefreshButton_Clicked" />

        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20,18,20,30"
                Spacing="16"
                MaximumWidthRequest="1100"
                HorizontalOptions="Fill">

                <!-- SUMMARY -->
                <Border
                    BackgroundColor="#146B3A"
                    StrokeThickness="0"
                    Padding="22"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="ESTIMATED BASKET TOTAL"
                            FontSize="12"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            TextColor="#D8F0E1" />

                        <Label
                            x:Name="EstimatedTotalLabel"
                            Text="R 0.00"
                            FontSize="36"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <HorizontalStackLayout Spacing="6">

                            <Label
                                x:Name="ItemCountLabel"
                                Text="0"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="products in your basket"
                                FontSize="14"
                                TextColor="#D8F0E1" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- LIST DETAILS -->
                <Border Style="{StaticResource CardStyle}">

                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Your Grocery List"
                                Style="{StaticResource HeadingStyle}"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Text="+ New List"
                                BackgroundColor="Transparent"
                                TextColor="#146B3A"
                                FontAttributes="Bold"
                                FontSize="13"
                                Padding="8,4"
                                Clicked="NewListButton_Clicked" />

                        </Grid>

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="List Name"
                                Style="{StaticResource FieldLabelStyle}" />

                            <Entry
                                x:Name="ListNameEntry"
                                Style="{StaticResource InputStyle}"
                                Placeholder="e.g. Weekly Shopping" />

                        </VerticalStackLayout>

                        <!-- RETAILER BUTTON -->
                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="Shopping At"
                                Style="{StaticResource FieldLabelStyle}" />

                            <Button
                                x:Name="SelectRetailerButton"
                                Text="Select a retailer ▼"
                                BackgroundColor="#F3F6F4"
                                TextColor="#172B20"
                                FontSize="15"
                                FontAttributes="None"
                                CornerRadius="10"
                                HeightRequest="52"
                                HorizontalOptions="Fill"
                                Clicked="SelectRetailerButton_Clicked" />

                            <!-- HIDDEN PICKER FOR EXISTING API LOGIC -->
                            <Picker
                                x:Name="RetailerPicker"
                                IsVisible="False">

                                <Picker.Items>
                                    <x:String>Pick n Pay</x:String>
                                    <x:String>Shoprite</x:String>
                                    <x:String>Checkers</x:String>
                                    <x:String>SPAR</x:String>
                                    <x:String>Woolworths Food</x:String>
                                    <x:String>Boxer</x:String>
                                    <x:String>Other</x:String>
                                </Picker.Items>

                            </Picker>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- PRODUCT FORM -->
                <Border Style="{StaticResource CardStyle}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            x:Name="ProductFormTitleLabel"
                            Text="Add a Product"
                            Style="{StaticResource HeadingStyle}" />

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="Product Name"
                                Style="{StaticResource FieldLabelStyle}" />

                            <Entry
                                x:Name="ProductNameEntry"
                                Style="{StaticResource InputStyle}"
                                Placeholder="e.g. Milk 2L" />

                        </VerticalStackLayout>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="6">

                                <Label
                                    Text="Quantity"
                                    Style="{StaticResource FieldLabelStyle}" />

                                <Entry
                                    x:Name="QuantityEntry"
                                    Style="{StaticResource InputStyle}"
                                    Text="1"
                                    Keyboard="Numeric" />

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="6">

                                <Label
                                    Text="Price Each (R)"
                                    Style="{StaticResource FieldLabelStyle}" />

                                <Entry
                                    x:Name="PriceEntry"
                                    Style="{StaticResource InputStyle}"
                                    Placeholder="0.00"
                                    Keyboard="Numeric" />

                            </VerticalStackLayout>

                        </Grid>

                        <Button
                            x:Name="AddItemButton"
                            Text="+ Add to Basket"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Clicked="AddItemButton_Clicked" />

                        <Button
                            x:Name="CancelEditButton"
                            Text="Cancel Editing"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsVisible="False"
                            Clicked="CancelEditButton_Clicked" />

                    </VerticalStackLayout>

                </Border>

                <!-- ERROR -->
                <Border
                    x:Name="MessageBorder"
                    IsVisible="False"
                    BackgroundColor="#FFF1EF"
                    Stroke="#F2D5D1"
                    StrokeThickness="1"
                    Padding="12"
                    StrokeShape="RoundRectangle 10">

                    <Label
                        x:Name="ErrorLabel"
                        FontSize="13"
                        TextColor="#B42318"
                        LineBreakMode="WordWrap" />

                </Border>

                <!-- BASKET -->
                <Border Style="{StaticResource CardStyle}">

                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="My Basket"
                                Style="{StaticResource HeadingStyle}"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Text="Clear All"
                                BackgroundColor="Transparent"
                                TextColor="#B42318"
                                FontSize="13"
                                Padding="8,4"
                                Clicked="ClearItemsButton_Clicked" />

                        </Grid>

                        <VerticalStackLayout
                            x:Name="ItemsLayout"
                            Spacing="10" />

                        <BoxView
                            HeightRequest="1"
                            Color="#E4EAE6" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Estimated Total"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#172B20"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="ListTotalLabel"
                                Grid.Column="1"
                                Text="R 0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="#146B3A"
                                VerticalOptions="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- SAVE / BUDGET -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <Button
                        x:Name="SaveListButton"
                        Grid.Column="0"
                        Text="Save List"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="SaveListButton_Clicked" />

                    <Button
                        x:Name="CheckBudgetButton"
                        Grid.Column="1"
                        Text="Check Budget"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="CheckBudgetButton_Clicked" />

                </Grid>

                <!-- CHECKOUT -->
                <Button
                    x:Name="CheckoutButton"
                    Text="Review Checkout"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="CheckoutButton_Clicked" />

                <Label
                    Text="Review only. No payments are processed."
                    FontSize="12"
                    TextColor="#68776E"
                    HorizontalTextAlignment="Center" />

                <!-- EXISTING SAVED LIST CONTROLS -->
                <Border
                    IsVisible="False"
                    Style="{StaticResource CardStyle}">

                    <VerticalStackLayout Spacing="8">

                        <Button
                            Text="Refresh Saved Lists"
                            Clicked="LoadListsButton_Clicked" />

                        <ActivityIndicator
                            x:Name="ListsLoadingIndicator"
                            IsVisible="False"
                            IsRunning="False" />

                        <VerticalStackLayout
                            x:Name="SavedListsLayout"
                            Spacing="8" />

                    </VerticalStackLayout>

                </Border>

                <!-- EXISTING PRICE COMPARISON CONTROL -->
                <Border
                    IsVisible="False"
                    Style="{StaticResource CardStyle}">

                    <Button
                        x:Name="ComparePricesButton"
                        Text="Compare Retailer Prices"
                        Clicked="ComparePricesButton_Clicked" />

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>

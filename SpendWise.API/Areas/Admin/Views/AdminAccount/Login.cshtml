@model SpendWise.API.Areas.Admin.Models.AdminLoginViewModel

@{
    Layout = null;

    ViewData["Title"] = "SpendWise Admin Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>SpendWise Admin | Login</title>

    <link rel="stylesheet"
          href="~/admin-login.css"
          asp-append-version="true" />
</head>

<body>

    <main class="login-container">

        <section class="login-card">

            <div class="brand">
                <div class="brand-icon">S</div>
                <h1>SpendWise</h1>
                <p>ADMINISTRATION PORTAL</p>
            </div>

            <div class="welcome">
                <h2>Welcome back</h2>
                <p>Sign in to access your administration dashboard.</p>
            </div>

            <form action="/Admin/AdminAccount/Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="validation-summary" role="alert">
                    @Html.ValidationSummary(false, "")
                </div>

                <div class="form-group">

                    <label for="Email">Administrator email</label>

                    @Html.TextBoxFor(m => m.Email, new

                        {

                            type = "email",

                            id = "Email",

                            placeholder = "admin@spendwise.co.za",

                            autocomplete = "username"

                        })

                    @Html.ValidationMessageFor(m => m.Email,
                             "",
                             new { @class = "field-error" })

                </div>

                <div class="form-group">

                    <label for="Password">Password</label>

                    @Html.PasswordFor(m => m.Password, new

                        {

                            id = "Password",

                            placeholder = "Enter your password",

                            autocomplete = "current-password"

                        })

                    @Html.ValidationMessageFor(m => m.Password,
                             "",
                             new { @class = "field-error" })

                </div>

                <div class="login-options">

                    <label class="remember">
                        @Html.CheckBoxFor(m => m.RememberMe)
                        Remember me
                    </label>

                    <span class="forgot-text">
                        Forgot password?
                    </span>

                </div>

                <button type="submit" class="login-button">
                    Sign In Securely
                </button>

            </form>

            <div class="security-note">
                <span>🔒</span>
                Protected administrator access
            </div>

            <footer>
                © 2026 SpendWise. All rights reserved.
            </footer>

        </section>

    </main>

</body>
</html>

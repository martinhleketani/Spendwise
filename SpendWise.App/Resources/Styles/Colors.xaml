<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Martin SpendWise Brand -->
    <Color x:Key="Primary">#006B4F</Color>
    <Color x:Key="PrimaryDark">#004D3A</Color>
    <Color x:Key="PrimaryLight">#E8F5F0</Color>
    <Color x:Key="AccentGreen">#00A86B</Color>

    <!-- Background -->
    <Color x:Key="PageBackground">#F7F8FA</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#17201D</Color>
    <Color x:Key="TextSecondary">#6B7470</Color>

    <!-- Financial -->
    <Color x:Key="IncomeGreen">#159447</Color>
    <Color x:Key="ExpenseRed">#DC3545</Color>
    <Color x:Key="WarningOrange">#F59E0B</Color>

    <!-- General -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="BorderColor">#E1E6E4</Color>
    <Color x:Key="LightGray">#F1F3F2</Color>
    <Color x:Key="MediumGray">#D6DBD9</Color>
    <Color x:Key="DarkGray">#49514E</Color>
    <Color x:Key="DisabledColor">#AAB2AF</Color>

</ResourceDictionary>
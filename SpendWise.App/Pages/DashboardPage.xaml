<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpendWise.App.Pages.DashboardPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4F7F5">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Grid.Row="0"
              BackgroundColor="#0B5D3B"
              Padding="28,16">

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="2"
                                     VerticalOptions="Center">

                    <Label Text="Martin SpendWise"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"/>

                    <Label x:Name="WelcomeLabel"
                           Text="Welcome back"
                           TextColor="#CDE7DA"
                           FontSize="13"/>

                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="10"
                                       VerticalOptions="Center">

                    <!-- NOTIFICATION BUTTON -->
                    <Grid WidthRequest="44"
                          HeightRequest="42">

                        <Border BackgroundColor="#18724B"
                                StrokeThickness="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                StrokeShape="RoundRectangle 10">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnNotificationsTapped"/>
                            </Border.GestureRecognizers>

                            <Label Text="🔔"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>

                        </Border>

                        <!-- NOTIFICATION BADGE -->
                        <Border x:Name="NotificationBadge"
                                BackgroundColor="#10B981"
                                Stroke="#0B5D3B"
                                StrokeThickness="2"
                                WidthRequest="20"
                                HeightRequest="20"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                StrokeShape="RoundRectangle 10"
                                IsVisible="False">

                            <Label x:Name="NotificationCountLabel"
                                   Text="0"
                                   TextColor="White"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>

                        </Border>

                    </Grid>

                    <!-- PROFILE BUTTON -->
                    <Border BackgroundColor="#18724B"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="16,10">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnProfileTapped"/>
                        </Border.GestureRecognizers>

                        <Label Text="Profile"
                               TextColor="White"
                               FontSize="13"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>

                    </Border>

                </HorizontalStackLayout>

            </Grid>
        </Grid>

        <!-- MAIN DASHBOARD -->
        <ScrollView Grid.Row="1"
                    Padding="28,24">

            <VerticalStackLayout Spacing="20"
                                 HorizontalOptions="Fill">

                <!-- BANK ACCOUNT AND MONTHLY BUDGET -->
                <Grid ColumnDefinitions="1.15*,0.85*"
                      ColumnSpacing="20">

                    <!-- BANK ACCOUNT -->
                    <Border Grid.Column="0"
                            BackgroundColor="#0A5A38"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="24">

                        <VerticalStackLayout Spacing="14">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="2">

                                    <Label Text="Bank Account"
                                           TextColor="White"
                                           FontSize="17"
                                           FontAttributes="Bold"/>

                                    <Label Text="Account Balance"
                                           TextColor="#BEE3D2"
                                           FontSize="12"/>

                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        BackgroundColor="#1B734D"
                                        Stroke="#34966B"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="12,5"
                                        VerticalOptions="Start">

                                    <Label x:Name="BankStatusLabel"
                                           Text="Not Connected"
                                           TextColor="#E2F5EC"
                                           FontSize="11"
                                           FontAttributes="Bold"/>

                                </Border>

                            </Grid>

                            <BoxView Color="#6EE7B7"
                                     WidthRequest="28"
                                     HeightRequest="3"
                                     HorizontalOptions="Start"
                                     CornerRadius="2"/>

                            <Label x:Name="BankAccountInfoLabel"
                                   Text="Connect your bank securely to view your account balance."
                                   TextColor="#D8EFE4"
                                   FontSize="13"/>

                            <Label x:Name="WalletBalanceLabel"
                                   Text="—"
                                   TextColor="White"
                                   FontSize="28"
                                   FontAttributes="Bold"/>

                            <Button x:Name="ConnectBankButton"
                                    Text="Connect Bank Account"
                                    BackgroundColor="White"
                                    TextColor="#0A5A38"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HeightRequest="46"
                                    CornerRadius="12"
                                    Margin="0,4,0,0"
                                    Clicked="OnConnectBankClicked"/>

                        </VerticalStackLayout>

                    </Border>

                    <!-- MONTHLY BUDGET -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E2E8E5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="24">

                        <VerticalStackLayout Spacing="14"
                                             VerticalOptions="Center">

                            <Grid ColumnDefinitions="*,Auto">

                                <Label Text="Monthly Budget"
                                       TextColor="#0F172A"
                                       FontSize="17"
                                       FontAttributes="Bold"/>

                                <Label Grid.Column="1"
                                       Text="View →"
                                       TextColor="#0B5D3B"
                                       FontSize="13"
                                       FontAttributes="Bold">

                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="OnViewBudgetTapped"/>
                                    </Label.GestureRecognizers>

                                </Label>

                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="2">

                                    <Label Text="This Month"
                                           TextColor="#64748B"
                                           FontSize="12"/>

                                    <Label x:Name="TotalSpentLabel"
                                           Text="R 0.00"
                                           TextColor="#DC2626"
                                           FontSize="20"
                                           FontAttributes="Bold"/>

                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     HorizontalOptions="End">

                                    <Label Text="Budget Remaining"
                                           TextColor="#64748B"
                                           FontSize="12"/>

                                    <Label x:Name="BudgetRemainingLabel"
                                           Text="R 0.00"
                                           TextColor="#0B5D3B"
                                           FontSize="20"
                                           FontAttributes="Bold"/>

                                </VerticalStackLayout>

                            </Grid>

                            <ProgressBar x:Name="BudgetProgressBar"
                                         Progress="0"
                                         ProgressColor="#0B5D3B"
                                         BackgroundColor="#E2E8F0"
                                         HeightRequest="8"/>

                            <Grid ColumnDefinitions="*,Auto">

                                <Label x:Name="RemainingSummaryLabel"
                                       Text="R 0.00 remaining"
                                       TextColor="#0B5D3B"
                                       FontSize="13"
                                       FontAttributes="Bold"/>

                                <Label x:Name="BudgetPercentLabel"
                                       Grid.Column="1"
                                       Text="0% used"
                                       TextColor="#64748B"
                                       FontSize="12"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <!-- BANK INTEGRATION NOTICE -->
                <Border BackgroundColor="#EBF5F0"
                        Stroke="#C6E4D5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,12">

                    <Label Text="Bank integration is not connected yet. SpendWise will not display or store a fake bank balance."
                           TextColor="#1E4D38"
                           FontSize="12"/>

                </Border>

                <!-- QUICK ACTIONS -->
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Quick Actions"
                               TextColor="#0F172A"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>

                        <Border Grid.Column="1"
                                BackgroundColor="#0B5D3B"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="16,8">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnGroceryListsTapped"/>
                            </Border.GestureRecognizers>

                            <Label Text="My Grocery Lists"
                                   TextColor="White"
                                   FontSize="12"
                                   FontAttributes="Bold"/>

                        </Border>

                    </Grid>

                    <!-- QUICK ACTION BUTTONS -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*"
                          ColumnSpacing="12">

                        <!-- ACTIVITY -->
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                Stroke="#E2E8E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,16">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnActivityTapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">

                                <Label Text="⚙"
                                       TextColor="#0B5D3B"
                                       FontSize="16"
                                       HorizontalOptions="Center"/>

                                <Label Text="Activity"
                                       TextColor="#0F172A"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Border>

                        <!-- BUDGET -->
                        <Border Grid.Column="1"
                                BackgroundColor="White"
                                Stroke="#E2E8E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,16">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnViewBudgetTapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">

                                <Label Text="◔"
                                       TextColor="#0B5D3B"
                                       FontSize="16"
                                       HorizontalOptions="Center"/>

                                <Label Text="Budget"
                                       TextColor="#0F172A"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Border>

                        <!-- GROCERY -->
                        <Border Grid.Column="2"
                                BackgroundColor="White"
                                Stroke="#E2E8E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,16">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnGroceryTapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">

                                <Label Text="🛒"
                                       TextColor="#0B5D3B"
                                       FontSize="16"
                                       HorizontalOptions="Center"/>

                                <Label Text="Grocery"
                                       TextColor="#0F172A"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Border>

                        <!-- PURCHASE -->
                        <Border Grid.Column="3"
                                BackgroundColor="White"
                                Stroke="#E2E8E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,16">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnPurchaseTapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">

                                <Label Text="🛍"
                                       TextColor="#0B5D3B"
                                       FontSize="16"
                                       HorizontalOptions="Center"/>

                                <Label Text="Purchase"
                                       TextColor="#0F172A"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Border>

                        <!-- REPORTS -->
                        <Border Grid.Column="4"
                                BackgroundColor="White"
                                Stroke="#E2E8E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,16">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnReportsTapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">

                                <Label Text="📊"
                                       TextColor="#0B5D3B"
                                       FontSize="16"
                                       HorizontalOptions="Center"/>

                                <Label Text="Reports"
                                       TextColor="#0F172A"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Border>

                        <!-- INSIGHTS -->
                        <Border Grid.Column="5"
                                BackgroundColor="White"
                                Stroke="#E2E8E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,16">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnInsightsTapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">

                                <Label Text="📈"
                                       TextColor="#0B5D3B"
                                       FontSize="16"
                                       HorizontalOptions="Center"/>

                                <Label Text="Insights"
                                       TextColor="#0F172A"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>

                <!-- RECENT SPENDING -->
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="2">

                            <Label Text="Recent Spending"
                                   TextColor="#0F172A"
                                   FontSize="16"
                                   FontAttributes="Bold"/>

                            <Label Text="Recently recorded purchases"
                                   TextColor="#64748B"
                                   FontSize="12"/>

                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="View All"
                               TextColor="#0B5D3B"
                               FontSize="13"
                               FontAttributes="Bold"
                               VerticalOptions="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnViewTransactionsTapped"/>
                            </Label.GestureRecognizers>

                        </Label>

                    </Grid>

                    <!-- DYNAMIC TRANSACTIONS -->
                    <Border BackgroundColor="White"
                            Stroke="#E2E8E5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="18,14">

                        <VerticalStackLayout x:Name="RecentTransactionsLayout"
                                             Spacing="12">

                            <Label Text="No recent spending recorded yet."
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,15"/>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

                <!-- SECURE BANKING -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8E5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="18,14">

                    <VerticalStackLayout Spacing="4">

                        <Label Text="Secure Banking"
                               TextColor="#0F172A"
                               FontSize="14"
                               FontAttributes="Bold"/>

                        <Label Text="When bank integration is activated, all connections are managed exclusively through authorized banking and payment providers. SpendWise will never ask you to enter your banking password or PIN directly into the app."
                               TextColor="#64748B"
                               FontSize="12"
                               LineHeight="1.4"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>

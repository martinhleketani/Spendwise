<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SpendWise.App.Pages.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Reset Password"
    BackgroundColor="#F5F7F6">

    <Grid RowDefinitions="Auto,*">

        <!-- =====================================================
             HEADER
             ===================================================== -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#146B3A"
            Padding="20,18"
            ColumnDefinitions="Auto,*">

            <Button
                Grid.Column="0"
                Text="←"
                FontSize="24"
                WidthRequest="48"
                HeightRequest="48"
                Padding="0"
                BackgroundColor="Transparent"
                TextColor="White"
                Clicked="BackButton_Clicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Margin="12,0"
                VerticalOptions="Center"
                Spacing="1">

                <Label
                    Text="Reset Password"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Create your new SpendWise password"
                    FontSize="12"
                    TextColor="#D9F2E3" />

            </VerticalStackLayout>

        </Grid>


        <!-- =====================================================
             CONTENT
             ===================================================== -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="30,35"
                Spacing="20"
                MaximumWidthRequest="620"
                HorizontalOptions="Center">


                <!-- =================================================
                     ICON
                     ================================================= -->
                <Border
                    WidthRequest="90"
                    HeightRequest="90"
                    BackgroundColor="#E8F4ED"
                    StrokeThickness="0"
                    HorizontalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="45" />
                    </Border.StrokeShape>

                    <Label
                        Text="🔑"
                        FontSize="38"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>


                <!-- =================================================
                     TITLE
                     ================================================= -->
                <Label
                    Text="Create New Password"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#18211D"
                    HorizontalTextAlignment="Center" />


                <Label
                    Text="Enter your new password below. You will use this password the next time you sign in."
                    FontSize="14"
                    TextColor="#718078"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Margin="10,0" />


                <!-- =================================================
                     ERROR
                     ================================================= -->
                <Border
                    x:Name="ErrorCard"
                    IsVisible="False"
                    BackgroundColor="#FFF4F4"
                    Stroke="#F1C7C7"
                    StrokeThickness="1"
                    Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Label
                        x:Name="ErrorLabel"
                        Text=""
                        FontSize="13"
                        TextColor="#B42318"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </Border>


                <!-- =================================================
                     SUCCESS
                     ================================================= -->
                <Border
                    x:Name="SuccessCard"
                    IsVisible="False"
                    BackgroundColor="#EAF5EE"
                    Stroke="#BFDCC9"
                    StrokeThickness="1"
                    Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Label
                        x:Name="SuccessLabel"
                        Text=""
                        FontSize="13"
                        TextColor="#146B3A"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </Border>


                <!-- =================================================
                     PASSWORD CARD
                     ================================================= -->
                <Border
                    BackgroundColor="White"
                    Stroke="#DCE5DF"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">


                        <!-- =========================================
                             NEW PASSWORD
                             ========================================= -->
                        <Label
                            Text="New Password"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#18211D" />


                        <Grid ColumnDefinitions="*,Auto">

                            <Border
                                Grid.ColumnSpan="2"
                                BackgroundColor="#F1F3F2"
                                Stroke="#8A9690"
                                StrokeThickness="1.5"
                                HeightRequest="58"
                                Padding="12,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*,Auto">

                                    <Entry
                                        x:Name="NewPasswordEntry"
                                        Grid.Column="0"
                                        Placeholder="Enter new password"
                                        PlaceholderColor="#777777"
                                        IsPassword="True"
                                        TextColor="#173C2A"
                                        BackgroundColor="Transparent"
                                        FontSize="15"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                    <Button
                                        x:Name="ShowNewPasswordButton"
                                        Grid.Column="1"
                                        Text="Show"
                                        FontSize="12"
                                        WidthRequest="62"
                                        Padding="4,0"
                                        BackgroundColor="Transparent"
                                        TextColor="#146B3A"
                                        Clicked="ShowNewPasswordButton_Clicked" />

                                </Grid>

                            </Border>

                        </Grid>


                        <!-- =========================================
                             CONFIRM PASSWORD
                             ========================================= -->
                        <Label
                            Text="Confirm New Password"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#18211D"
                            Margin="0,4,0,0" />


                        <Grid ColumnDefinitions="*,Auto">

                            <Border
                                Grid.ColumnSpan="2"
                                BackgroundColor="#F1F3F2"
                                Stroke="#8A9690"
                                StrokeThickness="1.5"
                                HeightRequest="58"
                                Padding="12,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*,Auto">

                                    <Entry
                                        x:Name="ConfirmPasswordEntry"
                                        Grid.Column="0"
                                        Placeholder="Confirm new password"
                                        PlaceholderColor="#777777"
                                        IsPassword="True"
                                        TextColor="#173C2A"
                                        BackgroundColor="Transparent"
                                        FontSize="15"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center"
                                        ReturnType="Done"
                                        Completed="ConfirmPasswordEntry_Completed" />

                                    <Button
                                        x:Name="ShowConfirmPasswordButton"
                                        Grid.Column="1"
                                        Text="Show"
                                        FontSize="12"
                                        WidthRequest="62"
                                        Padding="4,0"
                                        BackgroundColor="Transparent"
                                        TextColor="#146B3A"
                                        Clicked="ShowConfirmPasswordButton_Clicked" />

                                </Grid>

                            </Border>

                        </Grid>


                        <!-- =========================================
                             PASSWORD INFORMATION
                             ========================================= -->
                        <Border
                            BackgroundColor="#F0F7F3"
                            Stroke="#D4E8DC"
                            StrokeThickness="1"
                            Padding="14">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="Password requirements"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#146B3A" />

                                <Label
                                    Text="• At least 8 characters"
                                    FontSize="11"
                                    TextColor="#50645A" />

                                <Label
                                    Text="• At least one uppercase letter"
                                    FontSize="11"
                                    TextColor="#50645A" />

                                <Label
                                    Text="• At least one lowercase letter"
                                    FontSize="11"
                                    TextColor="#50645A" />

                                <Label
                                    Text="• At least one number"
                                    FontSize="11"
                                    TextColor="#50645A" />

                            </VerticalStackLayout>

                        </Border>


                        <!-- =========================================
                             RESET BUTTON
                             ========================================= -->
                        <Button
                            x:Name="ResetPasswordButton"
                            Text="Reset Password"
                            HeightRequest="52"
                            CornerRadius="12"
                            BackgroundColor="#146B3A"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            Margin="0,4,0,0"
                            Clicked="ResetPasswordButton_Clicked" />


                        <!-- =========================================
                             LOADING
                             ========================================= -->
                        <ActivityIndicator
                            x:Name="LoadingIndicator"
                            IsVisible="False"
                            IsRunning="False"
                            Color="#146B3A"
                            HorizontalOptions="Center" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     BACK TO LOGIN
                     ================================================= -->
                <Button
                    x:Name="BackToLoginButton"
                    Text="Back to Login"
                    HeightRequest="48"
                    CornerRadius="12"
                    BackgroundColor="Transparent"
                    BorderColor="#146B3A"
                    BorderWidth="1.5"
                    TextColor="#146B3A"
                    FontAttributes="Bold"
                    Clicked="BackToLoginButton_Clicked" />


                <!-- =================================================
                     FOOTER
                     ================================================= -->
                <Label
                    Text="Martin SpendWise"
                    FontSize="11"
                    TextColor="#9AA69F"
                    HorizontalTextAlignment="Center"
                    Margin="0,8,0,20" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
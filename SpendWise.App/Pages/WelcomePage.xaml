<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SpendWise.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PrimaryDark}">

    <Grid RowDefinitions="*,Auto">

        <!-- Decorative background -->
        <Grid Grid.RowSpan="2"
              InputTransparent="True">

            <Border
                WidthRequest="350"
                HeightRequest="350"
                TranslationX="-180"
                TranslationY="-160"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                BackgroundColor="#105C48"
                Opacity="0.5"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="175" />
                </Border.StrokeShape>
            </Border>

            <Border
                WidthRequest="300"
                HeightRequest="300"
                TranslationX="150"
                TranslationY="120"
                HorizontalOptions="End"
                VerticalOptions="End"
                BackgroundColor="#12644D"
                Opacity="0.35"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="150" />
                </Border.StrokeShape>
            </Border>

        </Grid>

        <!-- Main welcome content -->
        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="24,30,24,15"
                Spacing="22"
                VerticalOptions="Center">

                <!-- Grocery trolley -->
                <Image
                    Source="grocery_trolley.png"
                    HeightRequest="260"
                    Aspect="AspectFit"
                    HorizontalOptions="Center" />

                <!-- Feature cards -->
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="10">

                    <Border Grid.Column="0"
                            BackgroundColor="#176A53"
                            Stroke="#32846C"
                            StrokeThickness="1"
                            Padding="12,15">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="6">

                            <Label Text="▥"
                                   FontSize="26"
                                   TextColor="#42F0A4"
                                   HorizontalTextAlignment="Center"/>

                            <Label Text="Plan"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>

                            <Label Text="Set your budget"
                                   FontSize="11"
                                   TextColor="#D8EEE7"
                                   HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="#176A53"
                            Stroke="#32846C"
                            StrokeThickness="1"
                            Padding="12,15">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="6">

                            <Label Text="☷"
                                   FontSize="26"
                                   TextColor="#42F0A4"
                                   HorizontalTextAlignment="Center"/>

                            <Label Text="Track"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>

                            <Label Text="Monitor spending"
                                   FontSize="11"
                                   TextColor="#D8EEE7"
                                   HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
                            BackgroundColor="#176A53"
                            Stroke="#32846C"
                            StrokeThickness="1"
                            Padding="12,15">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="6">

                            <Label Text="✦"
                                   FontSize="26"
                                   TextColor="#42F0A4"
                                   HorizontalTextAlignment="Center"/>

                            <Label Text="Spend Smarter"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>

                            <Label Text="Better choices"
                                   FontSize="11"
                                   TextColor="#D8EEE7"
                                   HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- Branding -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Martin SpendWise"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Plan. Track. Spend Smarter."
                        FontSize="17"
                        TextColor="#D8EEE7"
                        HorizontalTextAlignment="Center"/>

                    <BoxView
                        WidthRequest="70"
                        HeightRequest="4"
                        Color="#00C989"
                        CornerRadius="2"
                        HorizontalOptions="Center"
                        Margin="0,8,0,0"/>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Action buttons -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="24,12,24,28"
            Spacing="14">

            <Button
                Text="Login  →"
                HeightRequest="58"
                FontSize="17"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="{StaticResource AccentGreen}"
                CornerRadius="15"
                Clicked="LoginButton_Clicked"/>

            <Button
                Text="Create Account  →"
                HeightRequest="58"
                FontSize="17"
                FontAttributes="Bold"
                TextColor="#00684B"
                BackgroundColor="White"
                CornerRadius="15"
                Clicked="CreateAccountButton_Clicked"/>

            <Label
                Text="Your Money. A Smarter Tomorrow."
                FontSize="12"
                TextColor="#D8EEE7"
                HorizontalTextAlignment="Center"
                Margin="0,8,0,0"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>

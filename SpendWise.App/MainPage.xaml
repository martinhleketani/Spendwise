<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SpendWise.App.MainPage"
    Title="SpendWise"
    BackgroundColor="#F5F7FB">

    <ScrollView>

        <VerticalStackLayout
            Padding="22"
            Spacing="22">

            <!-- APP HEADER -->

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="SpendWise"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#172033" />

                    <Label
                        Text="Your personal finance dashboard"
                        FontSize="14"
                        TextColor="#64748B" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="🔔 Alerts"
                    Clicked="OnNotificationsClicked"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="12"
                    VerticalOptions="Center" />

            </Grid>

            <!-- WELCOME CARD -->

            <Border
                BackgroundColor="#1E3A8A"
                StrokeThickness="0"
                Padding="22"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Welcome to SpendWise"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Track your expenses, manage your budgets and make smarter financial decisions."
                        FontSize="14"
                        TextColor="#DBEAFE" />

                </VerticalStackLayout>

            </Border>

            <!-- FEATURES -->

            <Label
                Text="Your Financial Tools"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="#172033" />

            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                Padding="18"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="💰 Budget Management"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#172033" />

                    <Label
                        Text="Manage monthly spending limits and monitor your budget usage."
                        TextColor="#64748B" />

                </VerticalStackLayout>

            </Border>

            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                Padding="18"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="📊 Financial Analytics"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#172033" />

                    <Label
                        Text="Analyse your spending with Python-powered insights and interactive graphs."
                        TextColor="#64748B" />

                    <Label
                        Text="Coming soon"
                        FontSize="12"
                        TextColor="#2563EB" />

                </VerticalStackLayout>

            </Border>

            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                Padding="18"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="📄 Financial Reports"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#172033" />

                    <Label
                        Text="Generate detailed PDF reports of your financial activity."
                        TextColor="#64748B" />

                    <Label
                        Text="Coming soon"
                        FontSize="12"
                        TextColor="#2563EB" />

                </VerticalStackLayout>

            </Border>

            <!-- NOTIFICATIONS BUTTON -->

            <Button
                Text="View Budget Notifications"
                Clicked="OnNotificationsClicked"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="52" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SpendWise.App.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>

        <Grid Padding="25">

            <VerticalStackLayout
                MaximumWidthRequest="500"
                WidthRequest="450"
                HorizontalOptions="Center"
                Spacing="15">


                <!-- BACK -->
                <Button
                    Text="←"
                    FontSize="24"
                    TextColor="{StaticResource Primary}"
                    BackgroundColor="Transparent"
                    WidthRequest="50"
                    HeightRequest="50"
                    HorizontalOptions="Start"
                    Clicked="BackButton_Clicked" />


                <!-- LOGO -->
                <Border
                    WidthRequest="80"
                    HeightRequest="80"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource PrimaryLight}"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40" />
                    </Border.StrokeShape>

                    <Label
                        Text="👤"
                        FontSize="38"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>


                <!-- HEADING -->
                <Label
                    Text="Create Account"
                    Style="{StaticResource PageTitleStyle}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Create your Martin SpendWise account"
                    Style="{StaticResource BodyTextStyle}"
                    HorizontalTextAlignment="Center"
                    Margin="0,0,0,10" />


                <!-- FULL NAME -->
                <Label
                    Text="Full Name"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Border
                    BackgroundColor="#F1F3F2"
                    Stroke="#8A9690"
                    StrokeThickness="1.5"
                    HeightRequest="56"
                    Padding="12,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Entry
                        x:Name="FullNameEntry"
                        Placeholder="Enter your full name"
                        PlaceholderColor="#777777"
                        TextColor="#1E1E1E"
                        BackgroundColor="Transparent"
                        FontSize="15"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />

                </Border>


                <!-- EMAIL -->
                <Label
                    Text="Email"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Border
                    BackgroundColor="#F1F3F2"
                    Stroke="#8A9690"
                    StrokeThickness="1.5"
                    HeightRequest="56"
                    Padding="12,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Entry
                        x:Name="EmailEntry"
                        Placeholder="Enter your email"
                        PlaceholderColor="#777777"
                        TextColor="#1E1E1E"
                        BackgroundColor="Transparent"
                        Keyboard="Email"
                        FontSize="15"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />

                </Border>


                <!-- PASSWORD -->
                <Label
                    Text="Password"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Border
                    BackgroundColor="#F1F3F2"
                    Stroke="#8A9690"
                    StrokeThickness="1.5"
                    HeightRequest="56"
                    Padding="12,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="5">

                        <Entry
                            x:Name="PasswordEntry"
                            Grid.Column="0"
                            Placeholder="Create a password"
                            PlaceholderColor="#777777"
                            TextColor="#1E1E1E"
                            BackgroundColor="Transparent"
                            IsPassword="True"
                            FontSize="15"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />

                        <Button
                            x:Name="ShowPasswordButton"
                            Grid.Column="1"
                            Text="Show"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}"
                            BackgroundColor="Transparent"
                            Padding="8,0"
                            VerticalOptions="Center"
                            Clicked="ShowPasswordButton_Clicked" />

                    </Grid>

                </Border>


                <!-- PASSWORD REQUIREMENTS -->
                <Label
                    Text="Use at least 8 characters with uppercase, lowercase, number and special character."
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}"
                    LineBreakMode="WordWrap" />


                <!-- CONFIRM PASSWORD -->
                <Label
                    Text="Confirm Password"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Border
                    BackgroundColor="#F1F3F2"
                    Stroke="#8A9690"
                    StrokeThickness="1.5"
                    HeightRequest="56"
                    Padding="12,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Entry
                        x:Name="ConfirmPasswordEntry"
                        Placeholder="Confirm your password"
                        PlaceholderColor="#777777"
                        TextColor="#1E1E1E"
                        BackgroundColor="Transparent"
                        IsPassword="True"
                        FontSize="15"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />

                </Border>


                <!-- ERROR -->
                <Label
                    x:Name="ErrorLabel"
                    IsVisible="False"
                    TextColor="{StaticResource ExpenseRed}"
                    FontSize="13"
                    HorizontalTextAlignment="Center" />


                <!-- REGISTER -->
                <Button
                    Text="Create Account"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="RegisterButton_Clicked"
                    Margin="0,10,0,0" />


                <!-- LOGIN -->
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="4">

                    <Label
                        Text="Already have an account?"
                        VerticalTextAlignment="Center"
                        TextColor="{StaticResource TextSecondary}" />

                    <Button
                        Text="Login"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        Padding="4,0"
                        Clicked="LoginButton_Clicked" />

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>
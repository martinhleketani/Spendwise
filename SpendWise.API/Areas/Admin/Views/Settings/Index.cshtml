@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";



    ViewData["Title"] = "Settings";
}

<style>
    .settings-page {
        padding: 10px 0;
    }

    .settings-header {
        margin-bottom: 25px;
    }

        .settings-header h2 {
            color: #30333b;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .settings-header p {
            color: #777;
            margin: 0;
            line-height: 1.6;
        }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .settings-card {
        background: #fff;
        border: 1px solid #e9e5ed;
        border-radius: 14px;
        padding: 24px;
        transition: .2s ease;
        text-decoration: none !important;
        color: inherit;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        cursor: pointer;
        min-width: 0;
    }

        .settings-card:hover {
            transform: translateY(-3px);
            border-color: #65a879;
            box-shadow: 0 6px 20px rgba(0,0,0,.06);
            color: inherit;
        }

        .settings-card:focus-visible {
            outline: 3px solid var(--green);
            outline-offset: 3px;
        }

    .settings-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #edf6ef;
        color: #34844a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        margin-bottom: 18px;
        flex-shrink: 0;
    }

    .settings-card h5 {
        font-weight: 700;
        margin-bottom: 9px;
        color: #30333b;
    }

    .settings-card p {
        color: #777;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 20px;
        flex-grow: 1;
    }

    .settings-card-action {
        margin-top: auto;
        max-width: 100%;
        pointer-events: none;
    }

    .settings-notice {
        margin-top: 25px;
        padding: 17px 20px;
        border-radius: 10px;
        background: #f5f2f8;
        border: 1px solid #e8e0ee;
        color: #62566b;
        font-size: 13px;
        line-height: 1.7;
    }

        .settings-notice i {
            margin-right: 5px;
        }

    @@media(max-width: 576px) {
        .settings-card {
            padding: 19px;
        }

        .settings-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="settings-page">

    <!-- PAGE HEADER -->

    <div class="settings-header">

        <h2>System Settings</h2>

        <p>
            Manage your SpendWise administration preferences and account settings.
        </p>

    </div>

    <!-- SETTINGS CARDS -->

    <div class="settings-grid">

        <!-- GENERAL SETTINGS -->

        <a href="@Url.Action("General", "Settings", new { area = "Admin" })"
           class="settings-card">

            <div class="settings-icon">
                <i class="bi bi-sliders"></i>
            </div>

            <h5>General Settings</h5>

            <p>
                Manage application information, system preferences,
                currency and regional settings.
            </p>

            <span class="admin-btn admin-btn-primary settings-card-action">
                Manage General Settings
                <i class="bi bi-arrow-right"></i>
            </span>

        </a>

        <!-- ADMINISTRATOR PROFILE -->

        <a href="@Url.Action("Profile", "Settings", new { area = "Admin" })"
           class="settings-card">

            <div class="settings-icon">
                <i class="bi bi-person-circle"></i>
            </div>

            <h5>Administrator Profile</h5>

            <p>
                View and manage your administrator account information
                and personal details.
            </p>

            <span class="admin-btn admin-btn-primary settings-card-action">
                Manage Profile
                <i class="bi bi-arrow-right"></i>
            </span>

        </a>

        <!-- SECURITY SETTINGS -->

        <a href="@Url.Action("Security", "Settings", new { area = "Admin" })"
           class="settings-card">

            <div class="settings-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h5>Security Settings</h5>

            <p>
                Review password security, login protection and
                administrator session preferences.
            </p>

            <span class="admin-btn admin-btn-primary settings-card-action">
                Manage Security
                <i class="bi bi-arrow-right"></i>
            </span>

        </a>

        <!-- NOTIFICATION SETTINGS -->

        <a href="@Url.Action("Notifications", "Settings", new { area = "Admin" })"
           class="settings-card">

            <div class="settings-icon">
                <i class="bi bi-bell"></i>
            </div>

            <h5>Notification Settings</h5>

            <p>
                Review notification preferences for user registrations,
                transactions and system activities.
            </p>

            <span class="admin-btn admin-btn-primary settings-card-action">
                Manage Notifications
                <i class="bi bi-arrow-right"></i>
            </span>

        </a>

    </div>

    <!-- SETTINGS INFORMATION -->

    <div class="settings-notice">

        <i class="bi bi-info-circle"></i>

        <strong>Settings information:</strong>

        These pages currently provide the administration interface.
        Database-backed configuration and saving will be connected
        in the next stage.

    </div>

</div>

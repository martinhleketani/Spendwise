<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SpendWise.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PrimaryDark}">

    <Grid RowDefinitions="*,Auto">

        <!-- Main Content -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <!-- Logo -->
            <Border
                HeightRequest="100"
                WidthRequest="100"
                HorizontalOptions="Center"
                BackgroundColor="White"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="50" />
                </Border.StrokeShape>

                <Label
                    Text="🛒"
                    FontSize="48"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

            </Border>

            <!-- App Name -->
            <Label
                Text="Martin SpendWise"
                TextColor="White"
                FontSize="36"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,0" />

            <!-- Tagline -->
            <Label
                Text="Plan. Track. Spend Smarter."
                TextColor="#D8EEE7"
                FontSize="17"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <!-- Buttons -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="25,20,25,35"
            Spacing="12">

            <Button
                Text="Login"
                Style="{StaticResource PrimaryButtonStyle}"
                BackgroundColor="{StaticResource AccentGreen}"
                Clicked="LoginButton_Clicked" />

            <Button
                Text="Create Account"
                Style="{StaticResource SecondaryButtonStyle}"
                BackgroundColor="White"
                Clicked="CreateAccountButton_Clicked" />

            <Label
                Text="Your Money. A Smarter Tomorrow."
                TextColor="#D8EEE7"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Margin="0,8,0,0" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>